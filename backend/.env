# OAuth2 Client Secret — paired with GOOGLE_CLIENT_ID, keep private
GOOGLE_CLIENT_SECRET=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
# OAuth2 Refresh Token — obtained once via OAuth flow, never expires unless revoked
