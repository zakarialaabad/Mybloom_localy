# Gmail SMTP port (587 = TLS/STARTTLS, 465 = SSL)
MAIL_PORT=587
# Gmail account username used for SMTP authentication
MAIL_USERNAME=zakarialaalbad200@gmail.com
# Gmail App Password (16-char, generated from myaccount.google.com/apppasswords)
MAIL_PASSWORD=iottdrjtfctaxbqr
# Encryption protocol — tls required for port 587
MAIL_ENCRYPTION=tls
# Default sender address shown in From: header for Laravel Mail facade
MAIL_FROM_ADDRESS=zakarialaalbad200@gmail.com
# Display name in From: header for Laravel Mail facade
MAIL_FROM_NAME="Parfum Store"
# Admin email for order notifications — used by SendAdminOrderEmail job
MAIL_ADMIN_EMAIL=zakarialaabad2005@gmail.com

# ── Google Gmail REST API (used by GmailService.php for order notifications)
# OAuth2 Client ID — from Google Cloud Console → Credentials → OAuth 2.0 Client IDs
