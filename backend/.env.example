APP_NAME=Parfum
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# ─── PRODUCTION: Use https://mybloom.ma ──────────────────────────────────
# ─── LOCAL: Use http://localhost:8000 ────────────────────────────────────
APP_URL=https://mybloom.ma

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database Configuration ──────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=parfum
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=database

# ─── Frontend URL (for CORS) ─────────────────────────────────────────────
# ─── PRODUCTION: Use https://mybloom.ma ──────────────────────────────────
# ─── LOCAL: Use http://localhost:3000 ────────────────────────────────────
FRONTEND_URL=https://mybloom.ma
FRONTEND_NETWORK_URL=

# ─── JWT Configuration ──────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true
JWT_ALGO=HS256

# ─── Mail Configuration ──────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@parfum.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Admin Email Configuration ───────────────────────────────────────────
# Admin email for order notifications — used by SendAdminOrderEmail & SendContactFormEmail jobs
MAIL_ADMIN_EMAIL=admin@example.com
ADMIN_EMAIL=admin@example.com

# ─── Google Gmail REST API Configuration ────────────────────────────────
# OAuth2 Client ID — from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id
# OAuth2 Client Secret — keep this private
GOOGLE_CLIENT_SECRET=your-client-secret
# OAuth2 Refresh Token — obtained via OAuth flow
GOOGLE_REFRESH_TOKEN=your-refresh-token
# From address for Gmail API emails
GMAIL_FROM="Your Store <your-gmail@gmail.com>"

# Self-hosted rmyndharis/OpenWA only. Session must be authenticated as +212639760141.
OPENWA_ENABLED=false
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
# Optional local-only alternative: absolute path to OpenWA's protected key
# file. Never use a frontend environment variable for either option.
OPENWA_API_KEY_FILE=
OPENWA_SESSION_ID=mybloom-owner
OPENWA_OWNER_E164=212639760141
# Fixed internal alert recipient. The backend rejects any other value.
OPENWA_ADMIN_RECIPIENT_E164=212611955060
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_URL=https://api.mybloom.ma/api/v1/webhooks/openwa
OPENWA_CONNECT_TIMEOUT=3
OPENWA_REQUEST_TIMEOUT=15
# Admin alerts use this separate, longer timeout; customer messaging remains
# on OPENWA_REQUEST_TIMEOUT.
OPENWA_ADMIN_REQUEST_TIMEOUT=45
OPENWA_AUTO_ACK_TIMEOUT_SECONDS=120
OPENWA_FALLBACK_TOKEN_TTL_HOURS=168
OPENWA_INVOICE_LINK_EXPIRY_DAYS=7
# Public HTTPS API origin for signed WhatsApp invoice links. In local LAN
# testing, use http://YOUR-LAN-IP:8000 (never localhost or 127.0.0.1).
OPENWA_INVOICE_PUBLIC_URL=https://mybloom.ma
