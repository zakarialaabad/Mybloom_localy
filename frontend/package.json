 {
  "name": "parfum-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "_comment_dev": "dev = normal localhost dev server (uses .env.local)",
    "dev": "next dev",
    "_comment_dev_network": "dev:network = loads .env.network (192.168.1.41 instead of localhost) and binds Next.js to 0.0.0.0 so phones/tablets on the same Wi-Fi can visit http://192.168.1.41:3000",
    "dev:network": "dotenv -e .env.network -- next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.7.2",
    "js-cookie": "^3.0.5",
    "lucide-react": "^0.575.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "swr": "^2.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "autoprefixer": "^10.4.19",
    "dotenv-cli": "^7.4.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.5",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
