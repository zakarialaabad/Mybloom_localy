# Backend API base URL (no trailing slash, no version — paths use /v1/... prefix)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Public-facing API hostname (used by Next.js image optimizer)
NEXT_PUBLIC_API_HOST=localhost

# App name displayed in the UI
NEXT_PUBLIC_APP_NAME=Parfum

# Token cookie name (must match Laravel Sanctum / JWT config)
NEXT_PUBLIC_TOKEN_COOKIE=parfum_token




# ─── Network / Mobile access (informational) ─────────────────────────────────
# When you need to visit the site from a phone or another PC on the same Wi-Fi,
# use the commands in package.json:  npm run dev:network
# That script starts Next.js with the .env.network file which swaps localhost
# for 192.168.100.32 — the two variables below are for reference only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_NETWORK_SITE_URL=http://192.168.100.32:3000
