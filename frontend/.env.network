# ─── Network mode — mobile & LAN access ──────────────────────────────────────
# Use this file when you want to visit the site from another device
# (mobile, tablet, another PC) on the same Wi-Fi network.
#
# Your machine's local IP: 192.168.11.105
#
# USAGE:
#   1. Start Laravel (binds to all interfaces):
#        cd backend
#        php artisan serve --host=0.0.0.0 --port=8000
#
#   2. Start Next.js in network mode (from /frontend):
#        npm run dev:network
#
#   3. Open on any device connected to the same Wi-Fi:
#        Website  → http://192.168.11.105:3000
#        API test → http://192.168.11.105:8000/api/v1/products
#
# This file OVERRIDES .env.local when loaded by dev:network.
# .env.local (localhost values) is NEVER modified.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://192.168.11.105:8000/api
NEXT_PUBLIC_API_HOST=192.168.11.105
NEXT_PUBLIC_APP_NAME=Parfum
NEXT_PUBLIC_TOKEN_COOKIE=parfum_token
NEXT_PUBLIC_SITE_URL=http://192.168.11.105:3000
NEXT_PUBLIC_NETWORK_SITE_URL=http://192.168.11.105:3000
NEXT_PUBLIC_NETWORK_API_URL=http://192.168.11.105:8000/api
